# Copy this to .env.local in the recorder repository.
# Never commit .env.local.

MARPLE_API_TOKEN=
MARPLE_USER=mdb_demo_aerospace
MARPLE_HOT_CATALOG=mdb_demo_aerospace_hot
MARPLE_COLD_CATALOG=mdb_demo_aerospace_cold
MARPLE_DATAPOOL=default
MARPLE_TRINO_HOST=query.db.marpledata.com
MARPLE_TRINO_PORT=443
MARPLE_HTTP_SCHEME=https

# Realtime SDK connection.
# MARPLE_DB_API_TOKEN can be different from MARPLE_API_TOKEN.
MARPLE_DB_API_TOKEN=
MARPLE_DB_API_URL=https://db.marpledata.com/api/v1
