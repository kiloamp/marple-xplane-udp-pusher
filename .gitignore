# Only the UDP recorder belongs in this repository. Other workspace tools stay local.
/*
!/.gitignore
!/.env.example
!/README.md
!/CONTRIBUTING.md
!/XPLANE_LIVE.md
!/requirements.txt
!/requirements-xplane.txt
!/env_loader.py
!/start_xplane_service.py
!/Start A320 Landing Challenge.command
!/xplane_*.py
!/tests/
/tests/*
!/tests/test_xplane*.py

# Defense in depth for credentials and generated files in any subdirectory.
.env
.env.*
!.env.example
*.pem
*.key
__pycache__/
*.py[cod]
*.log
.DS_Store
